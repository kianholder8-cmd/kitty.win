# Copy this file to .env and fill in real values.
# Render: set these in the service's Environment tab instead.

PORT=3000

# Public origin of the app. Used to build the Google redirect URI.
APP_URL=http://localhost:3000

# Random string, at least 32 characters. Sessions break if this changes.
SESSION_SECRET=replace-with-a-long-random-string

# Google OAuth. Leave blank to keep Google sign-in turned off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where users.json is written. On Render with a disk, set this to the mount path.
# DATA_DIR=/var/data
